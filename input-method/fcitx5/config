[Hotkey/AltTriggerKeys]

[Hotkey/EnumerateForwardKeys]

[Hotkey/EnumerateBackwardKeys]

[Hotkey/EnumerateGroupForwardKeys]

[Hotkey/EnumerateGroupBackwardKeys]

[Hotkey/ActivateKeys]

[Hotkey/DeactivateKeys]

[Behavior]
# Each window remembers whether the input method is on or off (off = first
# input method in the profile). Which non-first input method "on" means is
# shared by all windows.
ShareInputState=No
# Show a popup with the input method name when it changes.
ShowInputMethodInformation=True
